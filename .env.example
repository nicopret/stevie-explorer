EXPLORER_ENV=development

# Listen on all interfaces so LAN clients can reach the Explorer API.
API_HOST=0.0.0.0
API_PORT=8100

# Point Stevie and Stevie Explorer at the same absolute file.
DEVICE_REGISTRY_PATH=config/devices.json
DEVICE_REGISTRY_POLL_INTERVAL=1.0

# Latest discovered capability command state (separate from device configuration).
CAPABILITIES_FILE=config/capabilities.json
